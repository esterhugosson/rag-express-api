{
  "name": "rag-express-api",
  "version": "1.0.0",
  "description": "An express api, with pincone vector database, openAI embeddings and openAI LLM and Langchain.js",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --inspect --env-file=.env src/server.js",
    "clean": "node src/scripts/cleanWinedata.js",
    "embed": "node src/scripts/embedAndUpser.js",
    "seed": "node src/scripts/seed.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "npx eslint ./src || exit 0",
    "lint:fix": "npx eslint ./src --fix || exit 0"
  },
  "author": "Ester Hugosson",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@lnu/json-js-cycle": "^2.0.5",
    "@pinecone-database/pinecone": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "mongoose": "^8.17.0",
    "morgan": "^1.10.1",
    "openai": "^7.34.0",
    "winston": "^3.17.0",
    "winston-mongodb": "^7.0.0"
  },
  "devDependencies": {
    "@lnu/eslint-config": "^1.1.10",
    "nodemon": "^3.1.10"
  }
}
